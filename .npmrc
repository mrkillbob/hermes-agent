# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14

# eslint 10.12.0 (released 2026-10-02 20:08:19 UTC) is the locked version and fixes vulns.
# Remove this exception on 2026-10-16 at 20:08:19.213 UTC (14 days after release).
# npm exclusions match names, not versions.
min-release-age-exclude[]=eslint

# Remove source-map-js on 2026-10-14 at 14:08:09.382 UTC (14 days after 1.2.2's release).
min-release-age-exclude[]=source-map-js
